extends RefCounted
# Chapitre 7 : Le réseau

static func run(g) -> void:
	await g.card_text("CHAPITRE 7", "LE RESEAU\n\nEn janvier, le trio prend le train pour Amboise.")
	await g.scene("train")
	g.npc("Clara", "clara", Color(0.7, 0.35, 0.3))
	g.npc("Alex", "alex", Color(0.25, 0.4, 0.65))
	await g.say("Alex", "Le fichier marque Amboise « actif » et Chinon « dormant ». On y va.")
	g.obj("regarde le paysage par la fenêtre")
	await g.wait_near("window", 1.5)
	await g.say("Clara", "La Loire en hiver. Dire que tout ça tient sur un hexagone...")
	await g.scene("amboise")
	g.doc("porteurs", "PORTEURS, suivi historique", "Issues : un tiers d'incidents.\n\nFiche TEMPLIER : successeur non identifié.\nMise à jour peu avant l'arrivée de Darius.", "file")
	g.doc("appels", "Registre d'appels", "Contact de suivi : NE PAS ARCHIVER.\n\nUn numéro. Pas de nom.", "phone_log")
	g.obj("lis le dossier des porteurs et le registre d'appels")
	await g.wait_read("porteurs")
	await g.wait_read("appels")
	await g.say("Alex", "Ma cicatrice brûle. (voix) « Ils vous ont déjà trouvés aussi. »")
	g.spawn_enemy("silhouette")
	await g.fight(2, 45.0)
	await g.say("Voix", "(dans le casque) Une porte, ça s'ouvre dans les deux sens.")
	await g.scene("restaurant")
	g.npc("Franck", "franck", Color(0.55, 0.5, 0.45))
	await g.say("Franck", "Le thérapeute me l'a appris : Miel est mort de vieillesse, heureux, chez ses adoptants.")
	await g.say("Darius", "Alors il n'a jamais été dans cette machine pour de vrai ?")
	await g.scene("templier")
	await g.say("Darius", "Templier est mort en juin. Il m'a légué sa maison.")
	g.doc("lettre", "Lettre de Templier", "Darius,\n\nNe porte pas seul.\nCe lieu te protégera mieux que moi.\n\n- D. T.", "table")
	await g.wait_read("lettre")
	await g.scene("lenoir")
	g.npc("Clara", "franck", Color(0.7, 0.35, 0.3))
	await g.say("Clara", "En août, tu as claqué la porte. Je n'ai rien dit.")
	var c: int = await g.choice("Août : la brouille", ["Je suis désolé, Clara.", "Tu ne comprends pas."])
	await g.say("Clara", "On se réconcilie. On ne fait pas autrement." if c == 0 else "Je comprends mieux que tu ne crois. Reviens.")
	await g.scene("amboise")
	await g.say("Alex", "En octobre, le centre est vidé. On récupère le dossier avant les déménageurs.")
	g.doc("fiche", "Fiche FRANCK", "A RESURVEILLER VIA DESCENDANCE DIRECTE.", "file")
	await g.wait_read("fiche")
	await g.scene("vr")
	await g.say("Darius", "J'ajoute à mon jeu une silhouette qui observe, au loin.")
	await g.scene("lenoir")
	g.npc("Franck", "franck", Color(0.55, 0.5, 0.45))
	g.npc("Maman", Vector3(-1.5, 0, 0.6), Color(0.6, 0.4, 0.5))
	await g.say("Franck", "Une soirée avec les parents de Clara et d'Alex. Tout le monde ensemble, pour une fois.")
