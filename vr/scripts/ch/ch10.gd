extends RefCounted
# Chapitre 10 : Ce qui continue de guetter

static func run(g) -> void:
	await g.card_text("CHAPITRE 10", "CE QUI CONTINUE DE GUETTER\n\nLe deuil s'installe.")
	await g.scene("emilie")
	g.npc("Émilie", "emilie", Color(0.8, 0.6, 0.7))
	g.npc("Alex", "alex", Color(0.25, 0.4, 0.65))
	await g.say("Alex", "Émilie, ma petite sœur, dessine des couloirs de portes identiques. Et le numéro 404.")
	g.doc("dessins", "Dessins d'Émilie", "Des couloirs. Des portes numérotées, toutes identiques.\nEn bas de chaque feuille : 404.\n\nElle n'a jamais joué au jeu de Darius.", "drawings")
	g.obj("regarde les dessins d'Émilie")
	await g.wait_read("dessins")
	await g.say("Clara", "La transmission passe par le lieu, pas par le sang. Elle est peut-être touchée.")
	await g.card_text("QUATRE ANS PLUS TARD", "Un soir d'hiver, ils jouent enfin au jeu de Darius.")
	await g.scene("vr")
	g.obj("avance jusqu'à la porte close et ouvre-la")
	await g.wait_near("door", 2.5)
	await g.hold_at("door", 1.5, 0.6)
	await g.scene("perfect")
	g.npc("Templier", Vector3(-1.5, 0, 0.5), Color(0.55, 0.5, 0.4))
	g.npc("Kayden", Vector3(1.0, 0, -0.5), Color(0.3, 0.4, 0.7))
	g.doc("message", "Le message de Darius", "Si vous lisez ça, c'est que vous avez trouvé la dernière porte.\nJe n'ai pas pu vous le dire en face.\n\nCe qu'on porte ensemble, ça compte plus que tout le reste.\n\n- Darius", "photo")
	g.obj("lis le message de Darius")
	await g.wait_read("message")
	await g.say("Clara", "Il a construit une pièce pour eux. Pour tous ceux qu'on oublie.")
	await g.card_text("DIX ANS PLUS TARD", "")
	await g.scene("cemetery")
	g.npc("Clara", "clara", Color(0.7, 0.35, 0.3))
	await g.say("Clara", "Deux silhouettes... là, au fond. Tu les vois ?")
	g.spawn_enemy("silhouette")
	await g.fight(1, 40.0)
	await g.scene("lenoir")
	g.doc("societe", "Société écran", "Rachat des anciens sites M.13 par une société écran.\nReprésentant : A. VASSEUR.\n\nUne photo de Franck est jointe : « toujours là, toujours surveillé, toujours patients. »", "desk")
	g.obj("lis le rapport d'Alex")
	await g.wait_read("societe")
	await g.say("Alex", "On range les preuves et la lettre dans un coffre, sous le plancher.")
	g.obj("ouvre le coffre : pose la main sur le plancher")
	await g.hold_at("sofa", 2.0, 0.5)
	g.doc("invitation", "Invitation", "Le 16 février, à Fondettes.\n\nVenez seuls, ou ne venez pas du tout.", "desk")
	await g.wait_read("invitation")
	await g.say("Franck", "J'ai épousé Sylvie. Elle sait tout. Émilie sait tout aussi. On y va. Ensemble.")
