extends RefCounted
# Chapitre 1 : Miel

static func run(g) -> void:
	await g.card_text("CHAPITRE 1", "MIEL\n\nLuynes, un jeudi de novembre. Il pleut.")
	await g.scene("place")
	g.obj("approche de la machine bleutée, devant le bar-tabac")
	await g.say("Darius", "Personne ne regarde cette machine bleue, entre les journaux et le flipper.")
	await g.wait_near("machine", 2.2)
	await g.say("Darius", "Une dent de lait, une gourmette... et un collier de chien. Celui de Miel.")
	await g.say("Darius", "Papa a dit qu'il vivait chez le cousin Serge, à la campagne. J'avais huit ans.")
	g.doc("etiquette", "Etiquette sous le collier", "SUJET : DARIUS L.\nPAGE 41\n\nPour récupérer une page, vous devez abandonner une année.", Vector3(-3.0, 0.9, -8.2))
	g.obj("lis l'étiquette (attrape-la avec GRIP, rapproche-la de tes yeux)")
	await g.wait_read("etiquette")
	await g.say("Darius", "J'envoie une photo à Clara.")
	await g.say("Clara", "(message) Elle est encore là ? Viens chez moi. Alex est là.")
	# chez Clara
	await g.scene("clara_room")
	g.npc("Clara", "clara", Color(0.7, 0.35, 0.3))
	g.npc("Alex", "alex", Color(0.25, 0.4, 0.65))
	await g.say("Clara", "Ferme la porte. Je l'ai vue aussi, il y a deux ans. Avec la montre de mon père.")
	await g.say("Clara", "On m'a dit qu'il était en formation à Lyon. Il n'est jamais revenu.")
	g.doc("carnet", "Carnet de Clara", "La montre de papa.\nOn m'a dit : « en formation à Lyon ».\n\nPour chaque objet, une seule question :\nQU'EST-CE QU'ON M'A DIT A LA PLACE ?", "desk")
	g.obj("lis le carnet de Clara sur le bureau")
	await g.wait_read("carnet")
	await g.say("Alex", "Moi, je ne vois rien. Mais si vous deux la voyez, elle existe.")
	await g.say("Clara", "Promets-moi de ne pas y retourner ce soir, Darius.")
	await g.say("Darius", "Promis.")
	# deux heures du matin
	await g.card_text("2 h 17 DU MATIN", "")
	await g.scene("place")
	g.obj("pose la main sur la vitre de la machine")
	await g.say("Darius", "Je n'ai pas tenu ma promesse. Le souvenir de papa au téléphone me revient.")
	await g.say("Franck", "(souvenir) Le petit chien... c'est pour régler une dette. Vous le prenez quand ?")
	await g.hold_at("machine", 2.5, 0.35)
	await g.say("Darius", "La vitre est tiède. Mes yeux... ils brillent en bleu.")
	# Non-lieu
	await g.scene("nonlieu", {"doors": [38, 39, 40, 41, 42, 43]})
	await g.say("Kayden", "Bonsoir, Darius. Ici, c'est le Non-lieu. Ta page t'attend derrière l'une de ces portes.")
	g.obj("trouve la porte de ta page : 41")
	g.hint("Vise une porte avec le laser et appuie sur la gâchette.")
	await g.door_puzzle([38, 39, 40, 41, 42, 43], 41)
	await g.say("Kayden", "Page 41. Voyons ce que tu fais d'une vie parfaite.")
	# maison parfaite
	await g.scene("perfect")
	g.npc("Papa", "franck", Color(0.8, 0.75, 0.6))
	await g.say("Papa", "Bien dormi, mon grand ? Ici, pas de dettes. Pas de cousin Serge. Rien à cacher.")
	await g.say("Darius", "Tu parles comme lui. Tu n'es pas mon père.")
	g.obj("regarde le panier de Miel")
	await g.wait_near("miel", 1.4)
	await g.say("Darius", "Miel dort. Il ne respire pas. Comme un dessin.")
	await g.say("Darius", "Les murs se fendent en lignes bleues. La maison se déchire.")
	# entrepôt
	await g.scene("warehouse")
	g.obj("trouve le carton à ton nom")
	g.doc("carton", "Carton d'archives", "SUJET : DARIUS L.\n\n41 pages archivées.\n6 en attente.\n\nNe pas restituer sans contrepartie.", "carton")
	await g.wait_read("carton")
	g.give("poincon", "punch")
	g.obj("prends le poinçon K et range-le dans une poche")
	await g.wait_held("poincon")
	await g.say("Darius", "Un poinçon froid, gravé d'un K. Je le glisse dans ma poche sans réfléchir.")
	await g.scene("place")
	await g.say("Darius", "Je rouvre les yeux sur la place. Trois jours ont passé. Quelque chose a changé sous ma peau.")
	await g.say("Clara", "C'est vraiment là.")
