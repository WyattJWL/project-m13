extends RefCounted
# Chapitre 5 : Le poids de s'en souvenir seul

static func run(g) -> void:
	await g.card_text("CHAPITRE 5", "LE POIDS DE S'EN SOUVENIR SEUL\n\nDarius est le seul à tout garder en mémoire.")
	await g.scene("lenoir")
	g.doc("mot", "Mot plié en quatre", "Cherche F. avant qu'il ne cherche à oublier une deuxième fois.", "desk")
	g.doc("dossier", "Enveloppe kraft du buffet", "VASSEUR, Franck, 7 ans, 1991.\nSujet secondaire, programme M.13.\n\nRetiré du programme à la demande de la mère.\nChangement d'état civil : VASSEUR devient LENOIR.\n\nMention : « Ne jamais lui dire pour son frère. »", "buffet")
	g.obj("lis le mot, puis le dossier caché dans le buffet")
	await g.wait_read("mot")
	await g.wait_read("dossier")
	await g.say("Darius", "Papa est né Vasseur. Comme le chercheur. Comme Kayden.")
	await g.scene("college")
	g.npc("Alex", "alex", Color(0.25, 0.4, 0.65))
	g.npc("Clara", "clara", Color(0.7, 0.35, 0.3))
	await g.say("Darius", "Cours de techno. Le tableau numérique affiche « 404 », puis, en petit : « encore là ».")
	await g.say("Alex", "Dans le vieux disque de l'entrepôt : un fichier de 1994. « Je ne suis pas tout à fait parti. »")
	await g.say("Clara", "Mon carnet l'a écrit seul : le docteur avait deux fils. L'un est resté dans la machine. L'autre s'est caché sous un autre nom.")
	await g.scene("vasseur")
	g.doc("photos", "Mur de photos", "Un homme en blouse. Un grand garçon brun.\nEt un petit garçon de sept ans qui a exactement le sourire de ton père.", "photos")
	g.doc("dossiers", "Classeur « SUJETS »", "Sujets 1 à 12 : abandonnés.\nSujet 13 : KAYDEN V., porteur désigné.\nSujet 13-bis : FRANCK V., témoin à protéger.\n\n« Le programme a pris mes deux fils. Un dans la machine. Un sous un autre nom. »", "files")
	g.doc("ordi", "Écran cathodique", "41 DOSSIERS ACTIFS\n1 PAGE MANQUANTE\n\nPAGE 404 : INTROUVABLE,\nOU PAS ENCORE ECRITE.", "computer")
	g.obj("fouille la maison Vasseur : photos, classeur, ordinateur")
	g.give("knife", "franck")
	await g.wait_read("photos")
	await g.wait_read("dossiers")
	await g.wait_read("ordi")
	g.spawn_enemy("silhouette")
	await g.fight(2, 40.0)
	await g.scene("lenoir")
	g.npc("Franck", "franck", Color(0.55, 0.5, 0.45))
	await g.say("Franck", "Kayden était mon grand frère. J'avais sept ans. Maman m'a retiré du programme. Lui, elle n'a pas pu.")
	await g.say("Franck", "Il répétait toujours : « Je veux que ça compte. » Je n'ai jamais su ce qu'il voulait dire.")
	await g.say("Darius", "Dans le carnet de Clara, une ligne apparaît : « je veux juste qu'on arrête de m'oublier une deuxième fois. »")
	g.obj("mets le casque de réalité virtuelle")
	await g.hold_at("headset", 1.5, 0.3)
	await g.scene("vr")
	await g.say("Darius", "Mon jeu : un village, un chemin, et au bout une porte close éclairée de bleu.")
	await g.wait_near("door", 3.0)
	await g.say("Franck", "(derrière toi) Fais des sauvegardes. Mieux vaut trois sauvegardes que pas assez.")
