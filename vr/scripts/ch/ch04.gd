extends RefCounted
# Chapitre 4 : Le Non-lieu en flammes

static func run(g) -> void:
	await g.card_text("CHAPITRE 4", "LE NON-LIEU EN FLAMMES\n\nLe Non-lieu brûle en bleu. Luynes s'y dissout.")
	await g.scene("fire")
	g.npc("Clara", "clara", Color(0.7, 0.35, 0.3))
	g.npc("Alex", "alex", Color(0.25, 0.4, 0.65))
	g.give("knife", Vector3(-1.0, 0.2, 9.0))
	g.give("hatchet", Vector3(1.0, 0.2, 9.0))
	await g.say("Kayden", "Trois ? Tu m'en amènes trois ? J'aurai trois fois plus à garder.")
	await g.say("Clara", "Il veut des noms ? Je vais lui en donner. Tous ceux de mon carnet. Couvre-moi !")
	g.obj("protège Clara : repousse Kayden et ses Silhouettes")
	g.hint("Frappe à l'arme, utilise Retenir, ou lance des objets par télékinésie.")
	await g.boss("kayden", 3, 140.0)
	await g.say("Clara", "Les pages de mon carnet se remplissent toutes seules. Les anciens porteurs écrivent avec moi.")
	await g.say("Darius", "Je les sens derrière moi. Tous les Darius d'avant. Ils me poussent vers le centre.")
	g.obj("plante le bâton au centre (tiens-le contre le sol)")
	g.give("bat", Vector3(0.5, 0.3, 6.0))
	await g.wait_held("bat")
	await g.hold_at("center", 3.0, 1.0)
	await g.say("Darius", "Page 404 : on ne t'oublie pas. On te pardonne pas non plus. Mais on arrête de te nourrir.")
	await g.say("Kayden", "Je voulais juste... que ça compte.")
	await g.card_text("DIMANCHE D'OCTOBRE", "Tout s'éteint.")
	await g.scene("lenoir")
	await g.say("Darius", "Ma mère prépare le café. Clara et Alex ne se souviennent de rien. La machine a disparu.")
	g.give("poincon", "headset")
	g.doc("carnet", "Un carnet de Clara (son écriture)", "Si tu lis ça, c'est que ça a marché et que je ne m'en souviens pas.\nCroie-le. Il dit la vérité.\nMiel-Ambre.\n\n(Et dessous, des dizaines de prénoms, d'écritures anciennes. Tous : Darius.)", "desk")
	g.obj("retrouve le poinçon et lis le carnet")
	await g.wait_read("carnet")
	await g.say("Clara", "(je reconnais mon écriture sans m'en souvenir) Raconte-nous tout.")
	await g.say("Alex", "Cette cicatrice... exactement là où était la blessure. Je te crois, Darius.")
	await g.scene("restaurant")
	g.npc("Franck", "franck", Color(0.55, 0.5, 0.45))
	g.npc("Clara", "clara", Color(0.7, 0.35, 0.3))
	g.npc("Alex", "alex", Color(0.25, 0.4, 0.65))
	await g.say("Franck", "Déjeuner à Tours ! Clara, tiens. Un carnet ancien, chez un bouquiniste. Il paraît que tu écris beaucoup.")
	await g.say("Clara", "Ton père ne sait rien, Darius. Et pourtant il sait exactement quoi m'offrir.")
	g.obj("appelle Templier (pose la main sur la table)")
	await g.hold_at("table", 1.5, 0.5)
	await g.say("Templier", "(au téléphone) Darius. J'ai des documents. Viens quand tu seras prêt.")
	await g.say("Darius", "C'est pas un hasard qu'on soit devenus amis, tous les trois. Hein ?")
