extends RefCounted
# Chapitre 11 : Le domaine Vasseur

static func run(g) -> void:
	await g.card_text("CHAPITRE 11", "LE DOMAINE VASSEUR\n\nLe domaine de Fondettes a été rénové.")
	await g.scene("estate")
	g.npc("Ambroise", "ambroise", Color(0.15, 0.15, 0.2))
	await g.say("Ambroise", "Franck, Clara, Alex. Bienvenue. Je suis Ambroise Vasseur, le petit-fils du docteur.")
	g.doc("photos", "Couloir des porteurs", "Chaque cadre porte un nom.\nLe dernier : DARIUS LENOIR.", "gallery")
	g.obj("traverse le couloir des photos")
	await g.wait_read("photos")
	await g.say("Clara", "Ils ont mis Darius au même rang que tous les autres. Comme un trophée.")
	g.obj("rejoins le salon : une vingtaine de personnes autour d'un poinçon")
	await g.wait_near("punch_table", 5.0)
	g.npc("Odile", "odile", Color(0.5, 0.35, 0.5))
	await g.say("Odile", "J'ai été la Marge de mon frère quarante ans, avant de retrouver un chemin partiel.")
	await g.say("Clara", "Sa sœur... c'est la sœur de Templier. Et regarde : des éclats bleus dans leurs yeux.")
	await g.say("Ambroise", "Oui, nous portons tous une part de Kayden. Nous cohabitons avec elle.")
	await g.say("Franck", "Mon frère existe-t-il encore ?")
	await g.say("Ambroise", "Dilué n'est pas la même chose qu'éteint.")
	g.npc("Inconnu", "stranger", Color(0.3, 0.3, 0.3))
	await g.say("Inconnu", "(à voix basse) Ils promettent beaucoup. Ils expliquent moins qu'on voudrait.")
	g.doc("carte", "Carte du réseau mondial", "Des centaines de points bleus.\n\nNote : « Darius a failli compromettre nos plans. »", "map")
	g.obj("lis la note de la bibliothèque")
	await g.wait_read("carte")
	await g.say("Alex", "Failli compromettre. Ils le savaient, pour Darius. Ils parlent de lui comme d'un obstacle.")
	await g.say("Ambroise", "(hors de leur vue) Synchroniser tous les sites. Forcer la confrontation avec la source.")
	await g.say("Voix", "(dans le couloir, relayée à tous les sites) ... Ils sont là ?")
	await g.scene("emilie")
	g.npc("Émilie", "emilie", Color(0.8, 0.6, 0.7))
	await g.say("Émilie", "(endormie) Des portes numérotées. Toujours la même question.")
