extends RefCounted
# Chapitre 8 : Le compte à rebours

static func run(g) -> void:
	await g.card_text("CHAPITRE 8", "LE COMPTE A REBOURS\n\nFranck propose d'accompagner les enquêtes.")
	await g.scene("lenoir")
	g.npc("Franck", "franck", Color(0.55, 0.5, 0.45))
	await g.say("Franck", "Je viens avec vous. Plus de secrets, Darius.")
	g.obj("compose le numéro du registre (pose la main sur le clavier)")
	await g.hold_at("computer", 1.5, 0.4)
	await g.say("Voix", "Vous appelez un numéro qui n'existe pas. Ce n'est pas une menace. C'est un conseil.")
	await g.say("Darius", "Le carnet : « dossier réactivé, porteur identifié, surveillance renforcée autorisée. »")
	await g.scene("place_empty")
	await g.say("Darius", "Une voiture grise, un homme en costume. Ils rôdent depuis trois jours.")
	g.spawn_enemy("silhouette")
	await g.fight(2, 40.0)
	await g.scene("vr")
	await g.say("Jeu", "7 LUMIERES DETECTEES. 6 ETEINTES. 1 ALLUMEE.\nCOMPTE A REBOURS ACTIVE : 104 JOURS.\n16 FEVRIER.")
	await g.scene("library")
	g.doc("fevrier", "Incidents un 16 février", "1901 : disparition.\n1938 : éboulement.\n1954 : incendie.\n\nLe docteur Vasseur est né le 16 février 1938.", "manuscript")
	g.obj("lis les incidents du 16 février")
	await g.wait_read("fevrier")
	await g.say("Franck", "Une cérémonie annuelle, où Kayden était invité. On mesurait les années récupérées, on les offrait à « la source ».")
	await g.say("Kayden", "Cette fois, ce ne sera pas symbolique.")
	await g.scene("vr")
	await g.say("Darius", "Je termine un dernier niveau : un mémorial, pour tous ceux qu'on a oubliés.")
	await g.card_text("16 FEVRIER", "Une journée calme : promenade, Monopoly, dîner.")
	await g.scene("lenoir")
	g.npc("Franck", "franck", Color(0.55, 0.5, 0.45))
	g.npc("Clara", Vector3(-1.5, 0, 0.8), Color(0.7, 0.35, 0.3))
	g.npc("Alex", Vector3(0.5, 0, 0.2), Color(0.25, 0.4, 0.65))
	await g.say("Clara", "On remballe le Monopoly. Tu me dois deux cents euros.")
	await g.say("Franck", "Je vais chercher des pizzas. Vingt minutes. Ne bouge pas.")
	await g.say("Darius", "Moi, je finis une dernière texture derrière la porte close. Vingt minutes, pas plus.")
	await g.scene("vr")
	g.obj("ajuste la lumière derrière la porte (approche-toi)")
	await g.wait_near("door", 3.0)
