extends RefCounted
# Chapitre 9 : La dernière porte

static func run(g) -> void:
	await g.card_text("CHAPITRE 9", "LA DERNIERE PORTE")
	await g.scene("vr")
	g.obj("pose la main sur la porte")
	await g.hold_at("door", 2.0, 0.5)
	await g.say("Voix", "(un mélange de la sienne et de celle de Kayden) Je voulais juste que ça compte.")
	await g.say("Darius", "La porte s'entrouvre d'elle-même. Un éclair jaillit du casque.")
	await g.card_text("", "...", 3.0)
	await g.scene("lenoir")
	g.npc("Franck", "franck", Color(0.55, 0.5, 0.45))
	await g.say("Franck", "Pas de réponse au téléphone. Je rentre en courant. Darius ?")
	await g.say("Narrateur", "Un composant défectueux de la batterie. C'est la version officielle. Luynes parlera d'un accident.")
	await g.say("Narrateur", "Clara et Alex se souviennent de tout, sans oubli : ils n'étaient pas connectés.")
	await g.scene("church")
	g.npc("Franck", "franck", Color(0.55, 0.5, 0.45))
	g.npc("Clara", "clara", Color(0.7, 0.35, 0.3))
	g.npc("Alex", "alex", Color(0.25, 0.4, 0.65))
	await g.say("Narrateur", "L'enterrement a lieu à l'église.")
	g.doc("notes", "Copie des notes de Clara", "Pour Darius :\nMiel-Ambre.\n\nOn te garde.", "coffin")
	g.obj("dépose les notes de Clara près du cercueil")
	await g.wait_read("notes")
	await g.hold_at("coffin", 1.5, 0.6)
	await g.scene("cemetery")
	g.npc("Clara", "clara", Color(0.7, 0.35, 0.3))
	g.obj("regarde le lampadaire qui clignote en bleu")
	await g.wait_near("lamp", 4.0)
	await g.say("Clara", "Comme la porte de son jeu. Tu as vu ?")
	await g.card_text("UN AN PLUS TARD", "Un colis anonyme arrive.")
	await g.scene("lenoir")
	g.doc("colis", "Colis anonyme", "DOSSIER TEMPLIER-LENOIR CLASSE.\nRECHERCHE DE SUCCESSEUR EN COURS.\nNE PAS INTERVENIR.", "desk")
	await g.wait_read("colis")
	await g.say("Clara", "On organise une veille sur les enfants de la commune. Puis on arrête, pour se préserver.")
	await g.scene("templier")
	g.npc("Franck", "templier", Color(0.55, 0.5, 0.45))
	await g.say("Franck", "Je reprends la maison du coteau. On entretient la vigne.")
	await g.say("Clara", "Je commence un roman. Alex s'oriente vers la cybersécurité.")
	await g.say("Clara", "On porte tous les deux un peu de lui.")
