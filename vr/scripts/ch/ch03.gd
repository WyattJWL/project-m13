extends RefCounted
# Chapitre 3 : Le grimoire et le bâton

static func run(g) -> void:
	await g.card_text("CHAPITRE 3", "LE GRIMOIRE ET LE BATON\n\nDarius rêve d'un sous-bois qu'il n'a jamais vu.")
	await g.scene("forest_dream")
	g.obj("avance jusqu'à la pierre gravée")
	await g.say("Darius", "Des pins, de la brume. Je sais où aller sans l'avoir jamais su.")
	await g.wait_near("clearing", 3.0)
	await g.say("Darius", "Dans l'écorce, une spirale. Au centre : 404.")
	g.give("bat", "stone")
	g.obj("prends le bâton gravé")
	await g.wait_held("bat")
	await g.say("Darius", "Il vibre quand je le serre. Au réveil, il sera au pied de mon lit.")
	await g.scene("library")
	g.npc("Mme Ferrand", "librarian", Color(0.45, 0.25, 0.4))
	await g.say("Mme Ferrand", "Les vieux registres ? Au fond. Et ne touchez pas au « grimoire des farces ».")
	g.doc("manuscrit", "Manuscrit, Luynes, 1962", "On l'appelle M treize. Elle échange un souvenir contre une année.\nElle a toujours un porteur, et le porteur s'appelle toujours Darius.\n\nUn laboureur. Un meunier, en 1871. Un jeune homme, cette année.\n\nPersonne ne se souvient d'eux. C'est le prix.", "manuscript")
	g.doc("grimoire", "« Grimoire des farces »", "Pas de farces. Des protocoles, datés et signés.\n\nPage cornée : OUVERTURE DE RAYON.\nA lire à voix haute devant une étagère.", "grimoire")
	g.obj("lis le manuscrit et le grimoire")
	await g.wait_read("manuscrit")
	await g.wait_read("grimoire")
	var c: int = await g.choice("Lire le rituel ?", ["Lire à voix haute", "Refermer le livre"])
	if c == 1:
		await g.say("Darius", "Je le referme... puis je me ravise. Il faut savoir.")
	await g.say("Darius", "Une étagère bascule dans un fracas. Derrière, un registre que personne n'a vu depuis des décennies.")
	g.doc("registre", "Registre des disparitions", "1901 ...\n1938 ...\n1954 ...\n1979 : une jeune fille, nom illisible.\n1994 : VASSEUR Kayden, 19 ans.\n\nLe dernier nom est entouré trois fois, à l'encre bleue.", "registry")
	await g.wait_read("registre")
	await g.say("Clara", "Kayden Vasseur, entouré trois fois. Quelqu'un avant nous a cherché la même chose.")
	await g.scene("lenoir")
	await g.say("Darius", "Chez moi, le ventilateur de l'ordinateur tourne à fond. Je ne l'ai pas allumé.")
	g.doc("pc", "Écran de l'ordinateur", "TU M'AS CHERCHE. ME VOILA.\n\nMessage envoyé à Clara : « Rejoins-moi à la machine à 3 h 17. Seule. »\n(Tu ne l'as pas écrit.)", "computer")
	g.doc("carte", "Carte postale (le coteau de Luynes)", "Ton père va mieux depuis qu'il ne se souvient plus du coteau.\n\n- D.", "desk")
	g.obj("lis l'écran et la carte postale")
	await g.wait_read("pc")
	await g.wait_read("carte")
	g.npc("Franck", "franck", Color(0.55, 0.5, 0.45))
	await g.say("Franck", "Fondettes... J'ai participé à un programme, enfant. Un grand garçon, Kayden, m'apportait des bonbons.")
	await g.say("Franck ?", "(sa voix change) Il ne t'a jamais dit que je l'aimais bien ? Il ne dit jamais rien, ton père.")
	await g.say("Franck", "... Pardon, de quoi on parlait ? Il est déjà cette heure-là ?")
	await g.say("Darius", "Ton téléphone vibre : « L'ARCHIVE EST PLEINE. LA DERNIERE PAGE S'ECRIRA CE SOIR. »")
	await g.scene("place")
	g.npc("Clara", "clara", Color(0.7, 0.35, 0.3))
	g.npc("Alex", "alex", Color(0.25, 0.4, 0.65))
	await g.say("Clara", "Miel-Ambre. Bon, c'est toi. On y va ensemble ou on n'y va pas.")
	g.obj("pose la main sur la vitre, tous les trois")
	await g.hold_at("machine", 2.5, 0.35)
	await g.say("Darius", "Kayden est déjà là, de l'autre côté. Il nous attendait.")
