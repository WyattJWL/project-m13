extends RefCounted
# Chapitre 12 : La fin du monde

static func run(g) -> void:
	await g.card_text("CHAPITRE 12", "LA FIN DU MONDE")
	await g.scene("place_empty")
	await g.say("Franck", "Le retour vers Luynes se fait dans la colère. Darius était un obstacle.")
	await g.scene("cemetery")
	g.npc("Franck", "grave", Color(0.55, 0.5, 0.45))
	await g.say("Narrateur", "Franck s'agenouille devant la tombe de son fils.")
	g.doc("pressentiment", "Carnet de Clara", "J'ai un mauvais pressentiment.\nUn vraiment mauvais.", "clara")
	g.obj("lis le carnet de Clara")
	await g.wait_read("pressentiment")
	await g.scene("lenoir")
	g.doc("rapport", "Rapport d'accident relu par Alex", "Composant défectueux. Rien d'anormal.\n\nRien, sauf une phrase en bas :\n« Rien n'a été effacé. »", "desk")
	await g.wait_read("rapport")
	await g.scene("forest_dream")
	g.npc("Darius", "clearing", Color(0.45, 0.55, 0.8))
	await g.say("Franck", "(en rêve) Darius ?")
	await g.say("Darius", "Ça va aller, papa.")
	await g.scene("estate")
	g.npc("Ambroise", "ambroise", Color(0.15, 0.15, 0.2))
	g.npc("Odile", "odile", Color(0.5, 0.35, 0.5))
	await g.say("Narrateur", "À Fondettes, l'assemblée n'est pas partie : elle s'est étoffée. Ambroise active le réseau.")
	await g.say("Narrateur", "À Loches, à Blois, en Italie, d'autres assemblées attendent. Odile hésite.")
	await g.scene("emilie")
	g.npc("Émilie", "emilie", Color(0.8, 0.6, 0.7))
	await g.say("Narrateur", "Dans la nuit, Émilie rêve encore de portes numérotées.")
	await g.scene("cemetery")
	g.obj("regarde la tombe de Darius")
	await g.wait_near("grave", 3.0)
	await g.say("Narrateur", "Du givre dessine sur la tombe des lignes verticales : le motif du Non-lieu.")
	await g.say("Narrateur", "Une lumière bleue se fige en lignes verticales.")
	await g.say("Voix", "C'est bon, ils sont tous là ?")
	await g.say("Ambroise", "Oui. Ils sont tous là.")
	await g.say("Voix", "Commençons la fin du monde.")
